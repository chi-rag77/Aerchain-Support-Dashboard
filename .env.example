# ── Frontend (Vite) — safe to expose, protected by RLS ──────────────────────
# The dashboard reads tickets from Supabase using these. This deployment is the
# multi-customer roll-up (all Aerchain customers except NSE).
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Label shown across the UI. Default "All Customers" for the roll-up view.
VITE_COMPANY_NAME=All Customers
# Optional full name used on the login screen subtitle.
VITE_COMPANY_FULL_NAME=all Aerchain customers

# ── Edge Function secrets (server-side only — DO NOT put in frontend .env) ───
# Set these with the Supabase CLI, never commit them:
#   supabase secrets set FRESHDESK_DOMAIN=aerchain.freshdesk.com
#   supabase secrets set FRESHDESK_API_KEY=your_freshdesk_api_key
#   supabase secrets set FRESHDESK_EXCLUDE_COMPANY_NAME=NSE  # cf_company values to drop (comma-sep.)
#   # FRESHDESK_COMPANY_NAME is left UNSET here so ALL companies sync (minus the excludes).
#   supabase secrets set SYNC_CREATED_AFTER=2026-08-01T00:00:00Z  # optional
#   supabase secrets set SYNC_CONVERSATIONS=true      # optional
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
